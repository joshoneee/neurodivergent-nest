---
import Layout from '../layouts/Layout.astro';
import BlogCard from '../components/BlogCard.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
const sortedPosts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const featuredPosts = sortedPosts.filter(p => p.data.featured).slice(0, 3);
const recentPosts = sortedPosts.slice(0, 6);
---

<Layout title="Home">
  <!-- Hero -->
  <section class="bg-gradient-to-br from-violet-50 via-white to-teal-50 py-20 px-4 sm:px-6">
    <div class="max-w-4xl mx-auto text-center">
      <div class="inline-flex items-center gap-2 px-4 py-2 bg-violet-100 text-violet-700 rounded-full text-sm font-medium mb-6">
        <span>🧠</span> Built for brains that work differently
      </div>
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-stone-900 mb-6 leading-tight">
        Systems That Actually Work<br />
        <span class="text-violet-600">For Your Neurodivergent Brain</span>
      </h1>
      <p class="text-xl text-stone-500 mb-8 max-w-2xl mx-auto leading-relaxed">
        Practical tools, honest strategies, and ADHD-friendly systems for work, home, money, and life — written by neurodivergent people, for neurodivergent people.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/blog" class="btn-primary text-lg px-8 py-4">
          Explore Articles
        </a>
        <a href="/newsletter" class="btn-secondary text-lg px-8 py-4">
          Free Weekly Newsletter
        </a>
      </div>
    </div>
  </section>

  <!-- Trust bar -->
  <section class="bg-white border-y border-stone-100 py-6 px-4">
    <div class="max-w-4xl mx-auto">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
        {[
          { stat: '50K+', label: 'Monthly Readers' },
          { stat: '30+', label: 'Free Resources' },
          { stat: '8+', label: 'Topics Covered' },
          { stat: '100%', label: 'Neurodivergent-Led' },
        ].map(item => (
          <div>
            <div class="text-2xl font-extrabold text-violet-600">{item.stat}</div>
            <div class="text-xs text-stone-500 mt-1">{item.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Featured Posts -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 py-16">
    <div class="flex items-center justify-between mb-8">
      <h2 class="text-2xl font-bold text-stone-900">Featured Articles</h2>
      <a href={`${import.meta.env.BASE_URL}blog`} class="text-sm font-medium text-violet-600 hover:text-violet-700">View all →</a>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {featuredPosts.map(post => (
        <BlogCard
          title={post.data.title}
          description={post.data.description}
          slug={post.slug}
          pubDate={post.data.pubDate}
          category={post.data.category}
          featured={true}
        />
      ))}
    </div>
  </section>

  <!-- Value Props -->
  <section class="bg-stone-50 py-16 px-4 sm:px-6">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold text-stone-900 mb-3">Why Neurodivergent Nest?</h2>
        <p class="text-stone-500 max-w-xl mx-auto">Because generic productivity advice was designed for neurotypical brains. We're done with that.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {[
          {
            icon: '🎯',
            title: 'Actually Practical',
            desc: 'No vague advice. Every strategy is specific, actionable, and tested in neurodivergent life.',
          },
          {
            icon: '🧬',
            title: 'Science-Backed',
            desc: 'We reference ADHD research, occupational therapy, and executive function science — not just vibes.',
          },
          {
            icon: '💜',
            title: 'Non-Judgmental',
            desc: "You're not broken. Your environment hasn't been designed for your brain. We fix that.",
          },
        ].map(item => (
          <div class="text-center">
            <div class="text-4xl mb-4">{item.icon}</div>
            <h3 class="text-lg font-bold text-stone-900 mb-2">{item.title}</h3>
            <p class="text-stone-500 text-sm leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Recent Articles -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 py-16">
    <div class="flex items-center justify-between mb-8">
      <h2 class="text-2xl font-bold text-stone-900">Recent Articles</h2>
      <a href={`${import.meta.env.BASE_URL}blog`} class="text-sm font-medium text-violet-600 hover:text-violet-700">View all →</a>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {recentPosts.map(post => (
        <BlogCard
          title={post.data.title}
          description={post.data.description}
          slug={post.slug}
          pubDate={post.data.pubDate}
          category={post.data.category}
        />
      ))}
    </div>
  </section>

  <!-- Newsletter CTA -->
  <section class="bg-gradient-to-r from-violet-600 to-teal-600 py-16 px-4 sm:px-6">
    <div class="max-w-2xl mx-auto text-center">
      <h2 class="text-3xl font-bold text-white mb-3">Get Your Weekly System Drop</h2>
      <p class="text-violet-100 mb-8 leading-relaxed">
        Every Sunday: one ADHD-friendly system, one tool recommendation, and one real-life strategy. No fluff, no guilt, no "just try harder."
      </p>
      <form
        action="https://us13.list-manage.com/subscribe/post?u=3a549d398f&amp;id=f9b7814c98"
        method="post"
        class="flex flex-col sm:flex-row gap-3 max-w-md mx-auto"
      >
        <input
          type="email"
          name="EMAIL"
          placeholder="your@email.com"
          required
          class="flex-1 px-4 py-3 rounded-lg border-0 focus:outline-none focus:ring-2 focus:ring-white text-stone-800"
        />
        <button type="submit" class="bg-white text-violet-600 font-semibold px-6 py-3 rounded-lg hover:bg-violet-50 transition-colors whitespace-nowrap">
          Subscribe Free
        </button>
      </form>
      <p class="mt-3 text-xs text-violet-200">No spam. Unsubscribe any time. 100% free.</p>
    </div>
  </section>

  <!-- Topics -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 py-16">
    <h2 class="text-2xl font-bold text-stone-900 mb-8 text-center">Browse by Topic</h2>
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-4">
      {[
        { label: 'Organization', icon: '📦', href: `${import.meta.env.BASE_URL}blog#organization` },
        { label: 'Productivity', icon: '⚡', href: `${import.meta.env.BASE_URL}blog#productivity` },
        { label: 'Work & Career', icon: '💼', href: `${import.meta.env.BASE_URL}blog#work` },
        { label: 'Money Systems', icon: '💰', href: `${import.meta.env.BASE_URL}blog#finances` },
        { label: 'Relationships', icon: '❤️', href: `${import.meta.env.BASE_URL}blog#relationships` },
      ].map(topic => (
        <a
          href={topic.href}
          class="flex flex-col items-center gap-2 p-4 bg-white rounded-xl border border-stone-100 hover:border-violet-200 hover:bg-violet-50 transition-colors text-center group"
        >
          <span class="text-2xl">{topic.icon}</span>
          <span class="text-xs font-semibold text-stone-600 group-hover:text-violet-600">{topic.label}</span>
        </a>
      ))}
    </div>
  </section>
</Layout>
