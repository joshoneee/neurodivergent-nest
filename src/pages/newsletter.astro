---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Newsletter"
  description="The Neurodivergent Nest weekly newsletter — one practical ADHD system every Sunday. Free, zero fluff."
>
  <section class="max-w-2xl mx-auto px-4 sm:px-6 py-20 text-center">
    <div class="inline-flex items-center gap-2 px-4 py-2 bg-violet-100 text-violet-700 rounded-full text-sm font-medium mb-6">
      📬 Free Weekly Newsletter
    </div>
    <h1 class="text-4xl font-extrabold text-stone-900 mb-4">
      One System.<br />Every Sunday.<br />
      <span class="text-violet-600">Zero Guilt.</span>
    </h1>
    <p class="text-lg text-stone-500 mb-8 leading-relaxed">
      Join thousands of neurodivergent adults getting one practical, ADHD-friendly system delivered every Sunday morning — tools for work, home, money, and mind.
    </p>

    <form
      action="https://us13.list-manage.com/subscribe/post?u=3a549d398f&amp;id=f9b7814c98"
      method="post"
      class="flex flex-col gap-4 max-w-md mx-auto mb-8"
    >
      <input
        type="email"
        name="EMAIL"
        placeholder="your@email.com"
        required
        class="w-full px-5 py-4 rounded-xl border border-stone-200 text-stone-800 focus:outline-none focus:ring-2 focus:ring-violet-400 text-base"
      />
      <button type="submit" class="btn-primary w-full text-lg py-4 justify-center">
        Subscribe Free →
      </button>
    </form>

    <p class="text-xs text-stone-400 mb-12">No spam. Unsubscribe any time. We respect your inbox.</p>

    <!-- What you'll get -->
    <div class="bg-stone-50 rounded-2xl p-8 text-left">
      <h2 class="text-xl font-bold text-stone-900 mb-6 text-center">What's inside each issue</h2>
      <ul class="space-y-4">
        {[
          { icon: '🧠', title: 'One ADHD-Friendly System', desc: 'A specific, step-by-step strategy for something real — not generic advice.' },
          { icon: '🛠️', title: 'One Tool Worth Your Time', desc: 'An app, product, or resource we actually use and actually recommend.' },
          { icon: '📖', title: 'One Insight From Research', desc: 'Something from ADHD science that changes how you see yourself.' },
          { icon: '💬', title: 'Community Spotlight', desc: 'A real story or tip from our community of neurodivergent readers.' },
        ].map(item => (
          <li class="flex gap-4">
            <span class="text-2xl shrink-0">{item.icon}</span>
            <div>
              <p class="font-semibold text-stone-800">{item.title}</p>
              <p class="text-sm text-stone-500">{item.desc}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Layout>
