---
interface Props {
  title: string;
  description: string;
  slug: string;
  pubDate: Date;
  category: string;
  featured?: boolean;
}

const { title, description, slug, pubDate, category, featured = false } = Astro.props;

const formattedDate = pubDate.toLocaleDateString('en-US', {
  month: 'short',
  day: 'numeric',
  year: 'numeric',
});
---

<article class={`card group ${featured ? 'border-violet-200 bg-violet-50/30' : ''}`}>
  <div class="flex items-center gap-2 mb-3">
    <span class="text-xs font-semibold uppercase tracking-wider text-violet-600 bg-violet-100 px-2 py-1 rounded-full">
      {category}
    </span>
    {featured && (
      <span class="text-xs font-semibold uppercase tracking-wider text-amber-600 bg-amber-100 px-2 py-1 rounded-full">
        Featured
      </span>
    )}
  </div>
  <h3 class="text-lg font-bold text-stone-900 mb-2 group-hover:text-violet-600 transition-colors leading-snug">
    <a href={`/blog/${slug}`} class="stretched-link">
      {title}
    </a>
  </h3>
  <p class="text-stone-500 text-sm leading-relaxed mb-4">{description}</p>
  <div class="flex items-center justify-between text-xs text-stone-400">
    <time datetime={pubDate.toISOString()}>{formattedDate}</time>
    <span class="text-violet-500 font-medium group-hover:text-violet-700">Read more →</span>
  </div>
</article>
