        <h4 class="font-semibold text-white mb-3 text-sm uppercase tracking-wider">Explore</h4>
        <ul class="space-y-2 text-sm">
          <li><a href="/blog" class="hover:text-white transition-colors">All Articles</a></li>
          <li><a href="/resources" class="hover:text-white transition-colors">Tools & Resources</a></li>
          <li><a href="/newsletter" class="hover:text-white transition-colors">Free Newsletter</a></li>
